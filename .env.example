# --- LLM provider ---
# "anthropic" (default, used for local/dev) or "mock" (no key needed, used in CI/tests)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Vector store ---
# "faiss" (default, local dev) or "azure_ai_search" (production stub, see README)
VECTOR_STORE=faiss
VECTOR_STORE_PATH=./storage/index

# --- Embeddings ---
# "tfidf" (default, lightweight, no extra install) or "sentence_transformer"
# (stronger, semantic — requires requirements-embeddings-extra.txt, see README)
EMBEDDING_PROVIDER=tfidf

# --- Retrieval / grounding ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_SIMILARITY=0.15

# --- API auth (optional, simple demo header auth) ---
API_KEY=change-me-local-dev-key

# --- Azure production path (not used by default, see README "Production deployment") ---
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_SEARCH_ENDPOINT=
# AZURE_SEARCH_API_KEY=
# AZURE_SEARCH_INDEX=
